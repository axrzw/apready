{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm vercel-build",
  "crons": [
    {
      "path": "/api/cron/weekly",
      "schedule": "17 3 * * 1"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "41 2 * * *"
    }
  ]
}
# خمّن العمل: انسخ هذا الملف إلى apps/web/.env.local (الموقع) — سكربتات السحب تقرأه من هناك بعد.
# ما فيه ولا مفتاح إلزامي: بدونها كل شي يشتغل محلياً (SQLite + دخول تطوير + المصادر المجانية).

# --- الموقع ---
SITE_URL=http://localhost:3000
# سر توقيع جلسات الدخول: حط نص عشوائي طويل في الإنتاج (openssl rand -hex 32)
SESSION_SECRET=
# 1 = دخول تطوير بالاسم بدون ديسكورد، 0 = مقفل. الافتراضي: شغّال إذا ديسكورد مو مضبوط أو في وضع التطوير
DEV_LOGIN=
# 1 = المهمة الأسبوعية تشتغل من داخل الموقع
ENABLE_SCHEDULER=0

# --- البيانات ---
# sqlite (افتراضي) أو supabase
DATA_BACKEND=sqlite
GTW_DATA_DIR=
# Supabase (لما تنشئ مشروع): Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# supabase = بث الغرف عبر Supabase Realtime (لما يكون فيه أكثر من سيرفر أو بوت ديسكورد)
REALTIME=

# --- Discord OAuth --- https://discord.com/developers/applications -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# آيديات ديسكورد المسموحة (فاصلة). أو حط سيرفر الشلة وكل أعضاءه يدخلون
ALLOWED_DISCORD_IDS=
ALLOWED_DISCORD_GUILD_ID=
# الأدمن
ADMIN_DISCORD_IDS=

# --- مصادر تحتاج مفاتيح ---
# TMDB: https://www.themoviedb.org/settings/api (v3 key أو v4 Read Access Token)
TMDB_API_KEY=
# IGDB عبر Twitch: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# MyAnimeList (استيراد قوائم MAL): https://myanimelist.net/apiconfig
MAL_CLIENT_ID=

# --- أدوات ---
FFMPEG_PATH=
FFPROBE_PATH=

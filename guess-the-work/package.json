{
  "name": "guess-the-work",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/db && tsc -p packages/ingest && pnpm --filter web typecheck",
    "seed": "pnpm --filter @gtw/ingest seed",
    "weekly": "pnpm --filter @gtw/ingest weekly",
    "start": "pnpm --filter web start",
    "ocr": "pnpm --filter @gtw/ingest ocr",
    "names": "pnpm --filter @gtw/ingest names",
    "snapshot:import": "pnpm --filter @gtw/ingest snapshot:import",
    "snapshot:export": "pnpm --filter @gtw/ingest snapshot:export",
    "backup": "pnpm --filter @gtw/ingest backup",
    "restore": "pnpm --filter @gtw/ingest restore",
    "db:setup": "pnpm --filter @gtw/ingest db:setup",
    "lint": "pnpm --filter web lint",
    "vercel-build": "pnpm --filter @gtw/ingest db:setup && pnpm --filter web build",
    "e2e": "node e2e/e2e.cjs && node e2e/camera.cjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "tsx": "4.20.6",
    "@types/node": "22.15.30"
  },
  "engines": {
    "node": ">=22.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "ffmpeg-static",
      "esbuild",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
{
  "name": "guess-the-work",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r --filter ./packages/* run build && pnpm --filter web build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "seed": "pnpm --filter @gtw/ingest seed",
    "weekly": "pnpm --filter @gtw/ingest weekly"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "tsx": "4.20.6",
    "@types/node": "22.15.30"
  }
}

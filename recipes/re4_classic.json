{
  "id": "re4_classic",
  "name": "Resident Evil 4 (2005)",
  "name_ar": "ريزدنت إيفل 4 القديمة",
  "game": "Resident Evil 4 UHD",
  "steam_appid": 254700,
  "verified": false,
  "notes_ar": "النسخة القديمة (Ultimate HD) على ستيم، مو الريميك. ابدأ New Game على Normal أو Professional (Easy ما ينفع). استنى رسالة Save linked فوق يسار قبل ما تتحرك.",
  "sources": [
    "https://github.com/Pegzzzz/RE4-UHD-Archipelago/blob/main/TUTORIAL.md",
    "https://github.com/Pegzzzz/RE4-UHD-Archipelago/releases"
  ],
  "apworld": [
    {
      "type": "github_release",
      "repo": "Pegzzzz/RE4-UHD-Archipelago",
      "asset": "re4uhd.apworld",
      "prerelease": true,
      "to": "{custom_worlds}",
      "label": "RE4 UHD apworld"
    }
  ],
  "install": [
    {
      "type": "github_release",
      "repo": "Pegzzzz/RE4-UHD-Archipelago",
      "asset": "RE4-UHD-Archipelago.zip",
      "prerelease": true,
      "extract": true,
      "to": "{game_dir}/Bin32",
      "check": "{game_dir}/Bin32/dinput8.dll",
      "label": "RE4 UHD AP mod (dinput8)"
    }
  ],
  "connect": [],
  "launch": [
    {
      "type": "run",
      "exe": "{ap_dir}/ArchipelagoLauncher.exe",
      "label": "Resident Evil 4 UHD Client",
      "args": [
        "Resident Evil 4 UHD Client",
        "--",
        "--connect",
        "{address}",
        "--name",
        "{slot}"
      ],
      "optional_args": {
        "--password": "{password}"
      }
    },
    {
      "type": "steam_launch",
      "appid": 254700
    }
  ],
  "options": [
    {
      "key": "consumable_checks",
      "label_ar": "الذخيرة والعلاج checks",
      "help_ar": "كل ذخيرة وعشبة في الخريطة check (~450 زيادة). طفّه للعبة أقصر",
      "default": true
    },
    {
      "key": "starting_weapon",
      "label_ar": "سلاح إضافي في البداية",
      "help_ar": "",
      "default": "vanilla",
      "choices": [
        {
          "value": "vanilla",
          "label_ar": "لا"
        },
        {
          "value": "random_handgun",
          "label_ar": "مسدس عشوائي"
        },
        {
          "value": "random_weapon",
          "label_ar": "أي سلاح"
        }
      ]
    },
    {
      "key": "random_enemy_health",
      "label_ar": "صحة الأعداء عشوائية",
      "help_ar": "",
      "default": "off",
      "choices": [
        {
          "value": "off",
          "label_ar": "لا"
        },
        {
          "value": "mild",
          "label_ar": "خفيف"
        },
        {
          "value": "tough",
          "label_ar": "أقوى"
        },
        {
          "value": "wild",
          "label_ar": "مجنون"
        },
        {
          "value": "chaos",
          "label_ar": "فوضى"
        }
      ],
      "advanced": true
    },
    {
      "key": "merchant_checks",
      "label_ar": "checks التاجر",
      "help_ar": "أول شراء لكل غرض من التاجر يرسل check",
      "default": true,
      "advanced": true
    },
    {
      "key": "boss_checks",
      "label_ar": "checks البوسات",
      "help_ar": "",
      "default": true,
      "advanced": true
    },
    {
      "key": "shooting_gallery_checks",
      "label_ar": "checks ميدان الرماية",
      "help_ar": "",
      "default": true,
      "advanced": true
    }
  ],
  "guide_ar": [
    "اضغط ▶ العب: ينفتح كلاينت RE4 UHD متصل بالروم، وتشتغل اللعبة.",
    "ابدأ New Game على Normal أو Professional (Easy ما ينفع). كل multiworld جديد يبي New Game جديد.",
    "قبل ما تتحرك استنى رسالة «Save linked to this Archipelago seed» فوق يسار.",
    "لو علقت ورا باب، استخدم !hint في الكلاينت تشوف وين أغراضك."
  ],
  "checks_ar": "المفاتيح، والأسلحة اللي في الخريطة، والكنوز، والذخيرة والأعشاب، والبيزيتا، وأول شراء من التاجر، والبوسات، وميدان الرماية. ينرسل لحاله أول ما تسويه، وتطلع لك رسالة.",
  "avoid_ar": [
    "لا تلعب على Easy.",
    "كل multiworld يبي New Game جديد.",
    "لا تتحرك قبل رسالة Save linked فوق يسار.",
    "القرية والقلعة والجزيرة تتقفل وراك. لو فات شي مهم: F1 > Trainer > Area Jump."
  ],
  "checks_count_ar": "حوالي 750 check، وحوالي 250 لو طفيت الذخيرة والعلاج.",
  "length": "long",
  "genres": [
    "horror",
    "action"
  ],
  "beginner": false,
  "tips_ar": [
    "طويلة: خطط لكذا جلسة."
  ],
  "dl_fit": 2,
  "dl_fit_ar": "الموت متوقع بس مو كثير."
}

{
  "id": "dst",
  "name": "Don't Starve Together",
  "name_ar": "دونت ستارف توقذر",
  "game": "Don't Starve Together",
  "steam_appid": 322330,
  "verified": false,
  "notes_ar": "ملف واحد يكفي للسيرفر كله: اللي يفتح العالم بس يسوي ملفه، والباقين يدخلون عنده عادي بدون Archipelago. اللعبة صعبة، اختاروا Relaxed.",
  "sources": [
    "https://github.com/DragonWolfLeo/Archipelago-DST/blob/main/worlds/dst/docs/setup_en.md",
    "https://github.com/DragonWolfLeo/Archipelago-DST/releases",
    "https://steamcommunity.com/sharedfiles/filedetails/?id=3218471273"
  ],
  "apworld": [
    {
      "type": "github_release",
      "repo": "DragonWolfLeo/Archipelago-DST",
      "asset": "dontstarvetogether.apworld",
      "to": "{custom_worlds}",
      "label": "DST apworld + client"
    }
  ],
  "install": [
    {
      "type": "workshop",
      "id": "workshop_mod",
      "workshop_id": "3218471273",
      "label": "مود Archipelago Randomizer",
      "text_ar": "انفتحت صفحة مود Archipelago Randomizer في الورشة. اضغط Subscribe واستنى ستيم ينزله، وبعدها ارجع واضغط سويتها."
    }
  ],
  "connect": [],
  "launch": [
    {
      "type": "run",
      "exe": "{ap_dir}/ArchipelagoLauncher.exe",
      "label": "Don't Starve Together Client",
      "args": [
        "Don't Starve Together Client",
        "--",
        "--connect",
        "{address}",
        "--name",
        "{slot}"
      ],
      "optional_args": {
        "--password": "{password}"
      }
    },
    {
      "type": "steam_launch",
      "appid": 322330
    },
    {
      "type": "manual",
      "id": "connect_dst",
      "every_time": true,
      "text_ar": "في اللعبة: Host Game > Create New World، خل Save Type = Local Save، ومن تبويب Mods فعّل Archipelago Randomizer (من Server Mods). لو غيرت الفصول في الخيارات طابقها في إعدادات العالم. الكلاينت يتصل لحاله لما تدخل العالم."
    }
  ],
  "options": [
    {
      "key": "goal",
      "label_ar": "متى تخلص",
      "help_ar": "",
      "default": "survival",
      "choices": [
        {
          "value": "survival",
          "label_ar": "تعيش عدد من الأيام"
        },
        {
          "value": "bosses_any",
          "label_ar": "تقتل أي بوس من المطلوبين"
        },
        {
          "value": "bosses_all",
          "label_ar": "تقتل كل البوسات المطلوبة"
        }
      ]
    },
    {
      "key": "cave_regions",
      "label_ar": "الكهوف",
      "help_ar": "كم تدخل الكهوف في اللعبة",
      "default": "auto",
      "advanced": true,
      "choices": [
        {
          "value": "none",
          "label_ar": "لا"
        },
        {
          "value": "auto",
          "label_ar": "تلقائي"
        },
        {
          "value": "light",
          "label_ar": "شوي"
        },
        {
          "value": "full",
          "label_ar": "كاملة"
        }
      ]
    },
    {
      "key": "ocean_regions",
      "label_ar": "البحر",
      "help_ar": "",
      "default": "auto",
      "advanced": true,
      "choices": [
        {
          "value": "none",
          "label_ar": "لا"
        },
        {
          "value": "auto",
          "label_ar": "تلقائي"
        },
        {
          "value": "light",
          "label_ar": "شوي"
        },
        {
          "value": "full",
          "label_ar": "كامل"
        }
      ]
    }
  ],
  "guide_ar": [
    "ملف واحد يكفي للعالم كله: اللي يفتح العالم بس يسوي ملفه.",
    "اضغط ▶ العب: ينفتح كلاينت Don't Starve Together متصل بالروم، وتشتغل اللعبة.",
    "Host Game > Create New World، وخل Save Type = Local Save.",
    "من تبويب Mods فعّل Archipelago Randomizer (من Server Mods).",
    "لو غيرت الفصول في الخيارات طابقها في إعدادات العالم. ادخل العالم والكلاينت يتصل لحاله."
  ],
  "checks_ar": "بدل ما تتعلم الوصفات من آلات البحث، تكسبها من مهام داخل اللعبة وقتل البوسات. ينرسل لحاله أول ما تسويه، وتطلع لك رسالة.",
  "avoid_ar": [
    "ملف واحد يكفي للعالم كله.",
    "Save Type = Local Save.",
    "طابق الفصول وإعدادات العالم مع الخيارات.",
    "إعادة تعيين العالم تمسح تقدمك لو هدفك Survival."
  ],
  "checks_count_ar": "العدد بالضبط يعتمد على خياراتك، ويطلع لكل لاعب في صفحة الروم بعد التوليد.",
  "fix_if": [
    {
      "if": {
        "goal": [
          "bosses_any",
          "bosses_all"
        ],
        "cave_regions": [
          "none"
        ]
      },
      "set": {
        "cave_regions": "auto"
      }
    }
  ],
  "length": "long",
  "genres": [
    "coop",
    "chill"
  ],
  "beginner": false,
  "tips_ar": [
    "تلعبونها مع بعض في نفس العالم.",
    "اختار زعيم نهائي يناسب وقتكم."
  ],
  "dl_fit": 2,
  "dl_fit_ar": "الموت في Don't Starve مكلف، بس مع الشباب يصير قصة."
}

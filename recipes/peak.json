{
  "id": "peak",
  "name": "PEAK",
  "name_ar": "بيك",
  "game": "PEAK",
  "steam_appid": 3527290,
  "verified": false,
  "notes_ar": "لعبة تسلق مع الشباب. في اللعب الجماعي، بس سلوت صاحب اللوبي (الهوست) هو اللي يتأثر، والباقين يدخلون عنده عادي.",
  "sources": [
    "https://github.com/Mickemoose/peak-archipelago/blob/main/README.md",
    "https://github.com/Mickemoose/peak-archipelago/releases"
  ],
  "apworld": [
    {
      "type": "github_release",
      "repo": "Mickemoose/peak-archipelago",
      "asset": "peak.apworld",
      "to": "{custom_worlds}",
      "label": "PEAK apworld"
    }
  ],
  "install": [
    {
      "type": "github_release",
      "repo": "BepInEx/BepInEx",
      "asset": "BepInEx_win_x64_5.*.zip",
      "extract": true,
      "to": "{game_dir}",
      "check": "{game_dir}/winhttp.dll",
      "label": "BepInEx 5"
    },
    {
      "type": "github_release",
      "repo": "Mickemoose/peak-archipelago",
      "asset": "peakpelago_*.zip",
      "extract": true,
      "to": "{game_dir}/BepInEx/plugins",
      "check": "{game_dir}/BepInEx/plugins/peakpelago",
      "label": "PEAK Archipelago mod"
    }
  ],
  "connect": [
    {
      "type": "ini_set",
      "label": "بيانات الاتصال",
      "path": "{game_dir}/BepInEx/config/com.mickemoose.peak.ap.cfg",
      "section": "Connection",
      "values": {
        "Server": "{address}",
        "Slot": "{slot}",
        "Password": "{password}"
      }
    }
  ],
  "launch": [
    {
      "type": "steam_launch",
      "appid": 3527290
    }
  ],
  "options": [
    {
      "key": "goals",
      "label_ar": "متى تخلص",
      "help_ar": "لازم تخلّص كل اللي تعلّمه",
      "multi": true,
      "default": [
        "Reach Peak"
      ],
      "choices": [
        {
          "value": "Reach Peak",
          "label_ar": "توصل للقمة"
        },
        {
          "value": "Collect Badges",
          "label_ar": "تجمع الشارات"
        },
        {
          "value": "24 Karat Badge",
          "label_ar": "شارة 24 Karat"
        },
        {
          "value": "Free The Soul",
          "label_ar": "Free The Soul"
        }
      ]
    },
    {
      "key": "death_link_send_behavior",
      "label_ar": "متى يرسل Death Link",
      "deathlink": true,
      "help_ar": "",
      "default": "any_player_dies",
      "choices": [
        {
          "value": "any_player_dies",
          "label_ar": "لما يموت أي لاعب"
        },
        {
          "value": "all_players_dead",
          "label_ar": "لما يموتون كلهم"
        }
      ]
    },
    {
      "key": "death_link_behavior",
      "label_ar": "وش يصير لما يجيكم Death Link",
      "deathlink": true,
      "help_ar": "",
      "default": "kill_random_player",
      "choices": [
        {
          "value": "kill_random_player",
          "label_ar": "يموت لاعب عشوائي"
        },
        {
          "value": "reset_to_last_checkpoint",
          "label_ar": "ترجعون لآخر نقطة"
        }
      ]
    }
  ],
  "guide_ar": [
    "اضغط «جهّز اللعبة» (يركّب BepInEx والمود).",
    "اضغط ▶ العب: البرنامج يكتب الاتصال في المود، والمود يتصل لحاله.",
    "اللعب الجماعي: بس سلوت صاحب اللوبي يتأثر، والباقين يدخلون عنده عادي."
  ],
  "checks_ar": "أحداث وإنجازات في التسلق: الشارات، فتح الشنط، أخذ الأغراض، الأقسام. ينرسل لحاله أول ما تسويه، وتطلع لك رسالة.",
  "avoid_ar": [
    "في اللعب الجماعي بس سلوت صاحب اللوبي يتأثر.",
    "مودات تغيّر المناطق ممكن تخرب المنطق."
  ],
  "checks_count_ar": "العدد بالضبط يعتمد على خياراتك، ويطلع لكل لاعب في صفحة الروم بعد التوليد.",
  "length": "short",
  "genres": [
    "coop",
    "chill"
  ],
  "beginner": true,
  "tips_ar": [
    "تلعبونها مع بعض في نفس العالم."
  ],
  "dl_fit": 3,
  "dl_fit_ar": "تطيحون من الجبل مع بعض: Death Link هنا يضحك."
}

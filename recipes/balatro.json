{
  "id": "balatro",
  "name": "Balatro",
  "name_ar": "بالاترو",
  "game": "Balatro",
  "steam_appid": 2379780,
  "verified": false,
  "death_link_key": "deathlink",
  "notes_ar": "البرنامج يركّب Lovely و Steamodded والمود. سيفاتك العادية ما تتأثر، والمود يسوي بروفايل خاص اسمه Archipelago.",
  "sources": [
    "https://github.com/BurndiL/BalatroAP",
    "https://github.com/Steamodded/smods/wiki",
    "https://github.com/ethangreen-dev/lovely-injector/releases",
    "https://github.com/graygooglitch/balatroap_poptracker"
  ],
  "apworld": [
    {
      "type": "github_release",
      "repo": "BurndiL/BalatroAP",
      "asset": "balatro.apworld",
      "to": "{custom_worlds}",
      "label": "Balatro apworld"
    }
  ],
  "install": [
    {
      "type": "github_release",
      "repo": "ethangreen-dev/lovely-injector",
      "asset": "lovely-x86_64-pc-windows-msvc.zip",
      "extract": true,
      "to": "{game_dir}",
      "check": "{game_dir}/winmm.dll",
      "label": "Lovely injector"
    },
    {
      "type": "github_release",
      "repo": "Steamodded/smods",
      "asset": "__source__",
      "extract": true,
      "strip_top_folder": true,
      "to": "{appdata}/Balatro/Mods/smods",
      "label": "Steamodded"
    },
    {
      "type": "github_release",
      "repo": "BurndiL/BalatroAP",
      "asset": "BalatroAP.zip",
      "extract": true,
      "strip_top_folder": true,
      "to": "{appdata}/Balatro/Mods/BalatroAP",
      "label": "Balatro AP mod"
    }
  ],
  "connect": [
    {
      "type": "write_file",
      "label": "بيانات الاتصال",
      "path": "{appdata}/Balatro/APSettings.json",
      "merge": true,
      "ints": [
        "APPort"
      ],
      "content": {
        "APAddress": "{host}",
        "APPort": "{port}",
        "APSlot": "{slot}",
        "APPassword": "{password}"
      }
    }
  ],
  "launch": [
    {
      "type": "steam_launch",
      "appid": 2379780
    },
    {
      "type": "manual",
      "id": "connect_balatro",
      "every_time": true,
      "text_ar": "تحت يسار القائمة اختر بروفايل Archipelago. العنوان والاسم مكتوبة لك، اضغط Connect."
    }
  ],
  "options": [
    {
      "key": "goal",
      "label_ar": "متى تخلص",
      "help_ar": "",
      "default": "beat_decks",
      "choices": [
        {
          "value": "beat_decks",
          "label_ar": "تفوز بعدد من الـ Decks"
        },
        {
          "value": "beat_ante",
          "label_ar": "توصل لـ Ante معين"
        },
        {
          "value": "unlock_jokers",
          "label_ar": "تجمع عدد من الجوكرات"
        },
        {
          "value": "beat_decks_on_stake",
          "label_ar": "تفوز بـ Decks على Stake معين"
        },
        {
          "value": "beat_unique_decks",
          "label_ar": "تفوز بـ Decks مختلفة"
        }
      ]
    },
    {
      "key": "decks_win_goal",
      "label_ar": "كم Deck",
      "help_ar": "لو الهدف الـ Decks",
      "default": 4,
      "min": 1,
      "max": 15
    },
    {
      "key": "ante_win_goal",
      "label_ar": "أي Ante",
      "help_ar": "لو الهدف Ante",
      "default": 12,
      "min": 1,
      "max": 38
    }
  ],
  "guide_ar": [
    "اضغط «جهّز اللعبة» (يركّب Lovely و Steamodded والمود).",
    "اضغط ▶ العب.",
    "تحت يسار القائمة اختر بروفايل Archipelago. العنوان واسمك مكتوبة، اضغط Connect.",
    "سيفاتك العادية ما تتأثر."
  ],
  "checks_ar": "هزيمة الـ Boss Blind في كل Ante بكل Deck وكل Stake، وأغراض المحل. ينرسل لحاله أول ما تسويه، وتطلع لك رسالة.",
  "avoid_ar": [
    "العب من بروفايل Archipelago بس.",
    "انسخ سيفاتك احتياط قبل أول مرة (ما المفروض تتأثر، بس احتياط)."
  ],
  "checks_count_ar": "العدد بالضبط يعتمد على خياراتك، ويطلع لكل لاعب في صفحة الروم بعد التوليد.",
  "map_tracker": {
    "uid": "balatroap",
    "variant": "standard",
    "download": "https://github.com/graygooglitch/balatroap_poptracker/archive/refs/tags/v1.2.0.0.zip"
  },
  "length": "medium",
  "genres": [
    "chill"
  ],
  "beginner": true,
  "tips_ar": [
    "الجوكرات والبطاقات تنفتح بأغراض: أول ساعة خيارك محدود، عادي.",
    "ركّز على الـ stakes اللي تنفتح لك أول."
  ],
  "dl_fit": 2,
  "dl_fit_ar": "تخسر جولة = موتة. ممتع بس لا يكون معك ناس يلعبون ألعاب صعبة."
}

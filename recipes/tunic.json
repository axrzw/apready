{
  "id": "tunic",
  "name": "TUNIC",
  "name_ar": "تونك",
  "game": "TUNIC",
  "steam_appid": 553420,
  "verified": false,
  "notes_ar": "رسمية في Archipelago. البرنامج يركّب BepInEx 6 والمود ويكتب الاتصال. أول تشغيل بعد BepInEx ياخذ وقت أطول.",
  "sources": [
    "https://github.com/silent-destroyer/tunic-randomizer#installation",
    "https://github.com/silent-destroyer/tunic-randomizer/releases",
    "https://archipelago.gg/tutorial/TUNIC/setup/en",
    "https://github.com/SapphireSapphic/TunicTracker"
  ],
  "apworld": [
    {
      "type": "apworld_builtin"
    }
  ],
  "install": [
    {
      "type": "github_release",
      "repo": "BepInEx/BepInEx",
      "tag": "v6.0.0-pre.1",
      "asset": "BepInEx_UnityIL2CPP_x64_6.0.0-pre.1.zip",
      "extract": true,
      "to": "{game_dir}",
      "check": "{game_dir}/BepInEx/core",
      "label": "BepInEx 6 (IL2CPP)"
    },
    {
      "type": "github_release",
      "repo": "silent-destroyer/tunic-randomizer",
      "asset": "TunicRandomizer.zip",
      "extract": true,
      "to": "{game_dir}/BepInEx/plugins",
      "check": "{game_dir}/BepInEx/plugins/Tunic Randomizer",
      "label": "Tunic Randomizer"
    }
  ],
  "connect": [
    {
      "type": "write_file",
      "label": "بيانات الاتصال",
      "merge": true,
      "path": "{locallow}/Andrew Shouldice/Secret Legend/Randomizer/Settings.json",
      "content": {
        "ConnectionSettings": {
          "Player": "{slot}",
          "Hostname": "{host}",
          "Port": "{port}",
          "Password": "{password}"
        },
        "DeathLinkEnabled": "{death_link}"
      },
      "bools": [
        "DeathLinkEnabled"
      ]
    }
  ],
  "launch": [
    {
      "type": "steam_launch",
      "appid": 553420
    },
    {
      "type": "manual",
      "id": "connect_tunic",
      "every_time": true,
      "text_ar": "في شاشة البداية اختر وضع Archipelago. البيانات مكتوبة لك، اضغط Connect وابدأ New Game."
    }
  ],
  "options": [
    {
      "key": "hexagon_quest",
      "label_ar": "هدف Hexagon Quest",
      "help_ar": "تجمع Gold Questagons بدل النهاية العادية (أقصر)",
      "default": false
    },
    {
      "key": "hexagon_goal",
      "label_ar": "كم Questagon",
      "help_ar": "",
      "default": 20,
      "min": 1,
      "max": 100,
      "advanced": true
    },
    {
      "key": "entrance_rando",
      "label_ar": "خلط المداخل",
      "help_ar": "",
      "default": "no",
      "advanced": true,
      "choices": [
        {
          "value": "no",
          "label_ar": "لا"
        },
        {
          "value": "yes",
          "label_ar": "إيه"
        }
      ]
    }
  ],
  "death_link_key": null,
  "death_link_in_mod": true,
  "guide_ar": [
    "اضغط «جهّز اللعبة» (يركّب BepInEx 6 والمود). أول تشغيل ياخذ وقت.",
    "اضغط ▶ العب: البرنامج يكتب الاتصال واختيار Death Link في إعدادات المود.",
    "في شاشة البداية اختر وضع Archipelago واضغط Connect، وبعدها New Game."
  ],
  "checks_ar": "كل الصناديق، والأغراض المهمة، وصفحات الكتيّب، والـ relics. ينرسل لحاله أول ما تسويه، وتطلع لك رسالة.",
  "avoid_ar": [
    "العبها عادي قبل الراندومايزر، مو منصوح تبدأ فيه.",
    "ابدأ New Game بعد ما تتصل."
  ],
  "checks_count_ar": "العدد بالضبط يعتمد على خياراتك، ويطلع لكل لاعب في صفحة الروم بعد التوليد.",
  "map_tracker": {
    "uid": "tunic_sapphiresapphic",
    "variant": "standard",
    "download": "https://github.com/SapphireSapphic/TunicTracker/releases/download/2.3.0/TunicTracker.zip"
  },
  "length": "medium",
  "genres": [
    "action",
    "puzzle"
  ],
  "beginner": false,
  "tips_ar": [
    "العبها عادي قبل الراندو لو ما جربتها.",
    "الخريطة تساعد كثير."
  ],
  "dl_fit": 2,
  "dl_fit_ar": "الموت متوسط: Death Link مقبول."
}

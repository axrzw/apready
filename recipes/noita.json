{
  "id": "noita",
  "name": "Noita",
  "name_ar": "نويتا",
  "game": "Noita",
  "steam_appid": 881100,
  "verified": false,
  "notes_ar": "رسمية في Archipelago. البرنامج يحط المود في مجلد mods. تفعّله مرة من داخل اللعبة، وتكتب بيانات الروم في إعدادات المود.",
  "sources": [
    "https://archipelago.gg/tutorial/Noita/setup/en",
    "https://github.com/DaftBrit/NoitaArchipelago",
    "https://github.com/ScipioWright/Noita-poptracker"
  ],
  "apworld": [
    {
      "type": "apworld_builtin"
    }
  ],
  "install": [
    {
      "type": "github_release",
      "repo": "DaftBrit/NoitaArchipelago",
      "asset": "archipelago.zip",
      "extract": true,
      "to": "{game_dir}/mods/archipelago",
      "check": "{game_dir}/mods/archipelago/mod.xml",
      "label": "مود Archipelago"
    },
    {
      "type": "manual",
      "id": "noita_enable",
      "text_ar": "شغّل Noita مرة من ستيم: من Mods غيّر Unsafe mods إلى Allowed، وفعّل Archipelago ([x])، وسكّر اللعبة."
    }
  ],
  "connect": [],
  "launch": [
    {
      "type": "steam_launch",
      "appid": 881100
    },
    {
      "type": "manual",
      "id": "connect_noita",
      "every_time": true,
      "text_ar": "أول مرة أو روم جديد: Options > Mod Settings > Archipelago: اكتب Server = {host} و Port = {port} و Slot = {slot} (والباسورد لو فيه). بعدها ابدأ New Game، ويطلع شعار Archipelago تحت يمين."
    }
  ],

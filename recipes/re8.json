{
  "id": "re8",
  "name": "Resident Evil Village",
  "name_ar": "ريزدنت إيفل 8 (فيليج)",
  "game": "Resident Evil Village",
  "steam_appid": 1196590,
  "verified": false,
  "notes_ar": "لسا ألفا. يجي مع لانشر يركّب المود مرة وحدة. البرنامج يكتب الاتصال داخل اللعبة فتتصل لحالها. ابدأ New Game بنفس الصعوبة اللي اخترتها هنا. الـ DLC ما ينفع.",
  "sources": [
    "https://github.com/Snokay/Archipelago-RE-Village",
    "https://github.com/Snokay/Archipelago-RE-Village/blob/main/SETUP_GUIDE.md",
    "https://github.com/Snokay/Archipelago-RE-Village/releases"
  ],
  "apworld": [
    {
      "type": "github_release",
      "repo": "Snokay/Archipelago-RE-Village",
      "asset": "RE_Village_Archipelago_*_launcher.zip",
      "prerelease": true,
      "extract": true,
      "pick": "*/files/apworld/en/residentevilvillage.apworld",
      "to": "{custom_worlds}",
      "check": "{custom_worlds}/residentevilvillage.apworld",
      "label": "RE Village apworld"
    }
  ],
  "install": [
    {
      "type": "github_release",
      "repo": "Snokay/Archipelago-RE-Village",
      "asset": "RE_Village_Archipelago_*_launcher.zip",
      "prerelease": true,
      "extract": true,
      "strip_top_folder": true,
      "to": "{tools}/launcher",
      "check": "{tools}/launcher/RE_Village_AP_Launcher.exe",
      "label": "RE Village AP Launcher"
    },
    {
      "type": "manual",
      "id": "village_setup",
      "open_exe": "{tools}/launcher/RE_Village_AP_Launcher.exe",
      "done_if_exists": "{game_dir}/reframework/data/re_village_ap_client/install_manifest.json",
      "text_ar": "انفتح لك لانشر RE Village. في تبويب Setup اختر English واضغط Install / update (واللعبة مقفلة). مرة وحدة بس. سويتها؟"
    }
  ],
  "connect": [
    {
      "type": "write_file",
      "label": "بيانات الاتصال",
      "merge": true,
      "path": "{game_dir}/reframework/data/re_village_ap_client/connection.json",
      "content": {
        "host": "{address}",
        "slot": "{slot}",
        "password": "{password}",
        "auto": true
      }
    }
  ],
  "launch": [
    {
      "type": "steam_launch",
      "appid": 1196590
    }
  ],
  "options": [
    {
      "key": "difficulty",
      "label_ar": "الصعوبة",
      "help_ar": "لو اخترت صعوبة، لازم تلعب عليها وإلا ما تنحسب الـ checks",
      "default": "any",
      "choices": [
        {
          "value": "any",
          "label_ar": "أي صعوبة"
        },
        {
          "value": "casual",
          "label_ar": "Casual"
        },
        {
          "value": "standard",
          "label_ar": "Standard"
        },
        {
          "value": "hardcore",
          "label_ar": "Hardcore"
        },
        {
          "value": "village_of_shadows",
          "label_ar": "Village of Shadows"
        }
      ]
    },
    {
      "key": "goal",
      "label_ar": "الهدف",
      "help_ar": "وش لازم تسوي عشان تخلص",
      "default": "game_ending",
      "choices": [
        {
          "value": "game_ending",
          "label_ar": "نهاية اللعبة (Miranda)"
        },
        {
          "value": "four_lords",
          "label_ar": "الأسياد الأربعة"
        },
        {
          "value": "dimitrescu",
          "label_ar": "Dimitrescu بس (قصيرة)"
        }
      ]
    }
  ],
  "guide_ar": [
    "أول مرة: اضغط «جهّز اللعبة»، وينفتح لانشر RE Village. في تبويب Setup اختر English واضغط Install / update (واللعبة مقفلة).",
    "اضغط ▶ العب: البرنامج يكتب الاتصال داخل اللعبة، واللعبة تتصل لحالها.",
    "ابدأ New Game بنفس الصعوبة اللي اخترتها هنا. الـ DLC ما ينفع.",
    "Insert يفتح قائمة المود (الـ checks والتلميحات والمساعدة)."
  ],
  "checks_ar": "الأغراض في الخريطة، ومشتريات الـ Duke ووجباته، والصيد، وجوائز البوسات. ينرسل لحاله أول ما تسويه، وتطلع لك رسالة.",
  "avoid_ar": [
    "العب على الصعوبة اللي اخترتها هنا، وإلا ما ينحسب ولا check.",
    "ابدأ New Game. الـ DLC ما ينفع.",
    "لو غرض ناقص: قائمة Insert > Help > Give back all received items."
  ],
  "checks_count_ar": "حوالي 500 check.",
  "length": "medium",
  "genres": [
    "horror",
    "action"
  ],
  "beginner": true,
  "tips_ar": [
    "تحتاج تركب من البرنامج حقها أول مرة."
  ],
  "dl_fit": 2,
  "dl_fit_ar": "الموت متوقع بس مو كثير."
}

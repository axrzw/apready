{
  "id": "terraria",
  "name": "Terraria",
  "name_ar": "تيراريا",
  "game": "Terraria",
  "steam_appid": 1281930,
  "verified": false,
  "notes_ar": "تشتغل عن طريق tModLoader (ببلاش في ستيم). البرنامج يفعّل المود ويكتب إعدادات الاتصال لحاله. تقدر تلعبها مع مود Calamity، والبرنامج يركّبه لك. اللعبة أصعب مع الراندومايزر، فاختاروا صعوبة أقل من العادة.",
  "sources": [
    "https://archipelago.gg/tutorial/Terraria/setup/en",
    "https://steamcommunity.com/sharedfiles/filedetails/?id=2922217554",
    "https://github.com/Seldom-SE/archipelago_terraria_client",
    "https://github.com/ArchipelagoMW/Archipelago/blob/main/worlds/terraria/Options.py",
    "https://steamcommunity.com/sharedfiles/filedetails/?id=2824688072",
    "https://github.com/SerpentAI/TerrariaAPTracker"
  ],
  "apworld": [
    {
      "type": "apworld_builtin"
    }
  ],
  "install": [
    {
      "type": "workshop",
      "id": "workshop_mod",
      "workshop_id": "2922217554",
      "label": "مود Archipelago",
      "text_ar": "انفتحت صفحة مود Archipelago في الورشة. اضغط Subscribe واستنى ستيم ينزله، وبعدها ارجع واضغط سويتها."
    },
    {
      "type": "json_list_add",
      "label": "تفعيل المود",
      "path": "{documents}/My Games/Terraria/tModLoader/Mods/enabled.json",
      "items": [
        "SeldomArchipelago"
      ]
    },
    {
      "type": "workshop",
      "id": "workshop_calamity_music",
      "workshop_id": "2824688266",
      "when": {
        "calamity": true
      },
      "label": "Calamity Mod Music",
      "text_ar": "انفتحت صفحة Calamity Mod Music في الورشة (Calamity يحتاجه). اضغط Subscribe واستنى ستيم ينزله، وبعدها ارجع واضغط سويتها."
    },
    {
      "type": "workshop",
      "id": "workshop_calamity",
      "workshop_id": "2824688072",
      "when": {
        "calamity": true
      },
      "label": "Calamity Mod",
      "text_ar": "انفتحت صفحة Calamity Mod في الورشة. اضغط Subscribe واستنى ستيم ينزله، وبعدها ارجع واضغط سويتها."
    },
    {
      "type": "json_list_add",
      "label": "تفعيل Calamity",
      "path": "{documents}/My Games/Terraria/tModLoader/Mods/enabled.json",
      "items": [
        "CalamityModMusic",
        "CalamityMod"
      ],
      "when": {
        "calamity": true
      }
    },
    {
      "type": "json_list_remove",
      "label": "Calamity مطفي",
      "path": "{documents}/My Games/Terraria/tModLoader/Mods/enabled.json",
      "items": [
        "CalamityMod",
        "CalamityModMusic"
      ],
      "when": {
        "calamity": false
      }
    }
  ],
  "connect": [
    {
      "type": "write_file",
      "label": "بيانات الاتصال",
      "path": "{documents}/My Games/Terraria/tModLoader/ModConfigs/SeldomArchipelago_Config.json",
      "merge": true,
      "ints": [
        "port"
      ],
      "content": {
        "name": "{slot}",
        "port": "{port}",
        "address": "{host}",
        "password": "{password}"
      }
    }
  ],
  "launch": [
    {
      "type": "steam_launch",
      "appid": 1281930
    }
  ],

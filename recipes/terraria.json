{
  "id": "terraria",
  "name": "Terraria",
  "name_ar": "تيراريا",
  "game": "Terraria",
  "steam_appid": 1281930,
  "verified": false,
  "notes_ar": "تشتغل عن طريق tModLoader (ببلاش في ستيم). البرنامج يفعّل المود ويكتب إعدادات الاتصال لحاله. اللعبة أصعب مع الراندومايزر، فاختاروا صعوبة أقل من العادة.",
  "sources": [
    "https://archipelago.gg/tutorial/Terraria/setup/en",
    "https://steamcommunity.com/sharedfiles/filedetails/?id=2922217554",
    "https://github.com/Seldom-SE/archipelago_terraria_client",
    "https://github.com/ArchipelagoMW/Archipelago/blob/main/worlds/terraria/Options.py"
  ],
  "apworld": [
    {
      "type": "apworld_builtin"
    }
  ],
  "install": [
    {
      "type": "workshop",
      "id": "workshop_mod",
      "workshop_id": "2922217554",
      "label": "مود Archipelago",
      "text_ar": "انفتحت صفحة مود Archipelago في الورشة. اضغط Subscribe واستنى ستيم ينزله، وبعدها ارجع واضغط سويتها."
    },
    {
      "type": "json_list_add",
      "label": "تفعيل المود",
      "path": "{documents}/My Games/Terraria/tModLoader/Mods/enabled.json",
      "items": [
        "SeldomArchipelago"
      ]
    }
  ],
  "connect": [
    {
      "type": "write_file",
      "label": "بيانات الاتصال",
      "path": "{documents}/My Games/Terraria/tModLoader/ModConfigs/SeldomArchipelago_Config.json",
      "merge": true,
      "ints": [
        "port"
      ],
      "content": {
        "name": "{slot}",
        "port": "{port}",
        "address": "{host}",
        "password": "{password}"
      }
    }
  ],
  "launch": [
    {
      "type": "steam_launch",
      "appid": 1281930
    }
  ],
  "options": [
    {
      "key": "goal",
      "label_ar": "الهدف",
      "help_ar": "وش لازم تذبح عشان تخلص",
      "default": "mechanical_bosses",
      "choices": [
        {
          "value": "mechanical_bosses",
          "label_ar": "البوسات الميكانيكية (قصيرة)"
        },
        {
          "value": "plantera",
          "label_ar": "Plantera"
        },
        {
          "value": "golem",
          "label_ar": "Golem"
        },
        {
          "value": "lunatic_cultist",
          "label_ar": "Lunatic Cultist"
        },
        {
          "value": "moon_lord",
          "label_ar": "Moon Lord (طويلة)"
        }
      ]
    },
    {
      "key": "early_achievements",
      "label_ar": "إنجازات البداية",
      "help_ar": "تضيف checks من إنجازات أول اللعبة (تسرّع البداية)",
      "default": true,
      "advanced": true
    },
    {
      "key": "normal_achievements",
      "label_ar": "الإنجازات العادية",
      "help_ar": "باقي الإنجازات اللي مو بوسات أو أحداث",
      "default": true,
      "advanced": true
    },
    {
      "key": "grindy_achievements",
      "label_ar": "الإنجازات الطويلة",
      "help_ar": "إنجازات تبي تفريم كثير",
      "default": false,
      "advanced": true
    },
    {
      "key": "fishing_achievements",
      "label_ar": "إنجازات الصيد",
      "help_ar": "مهمات الصياد",
      "default": false,
      "advanced": true
    },
    {
      "key": "fill_extra_checks_with",
      "label_ar": "وش يجي في الـ checks الزايدة",
      "help_ar": "useful_items يخفف التفريم في البداية",
      "default": "useful_items",
      "choices": [
        {
          "value": "useful_items",
          "label_ar": "أغراض مفيدة"
        },
        {
          "value": "coins",
          "label_ar": "فلوس"
        }
      ],
      "advanced": true
    }
  ],
  "guide_ar": [
    "أول مرة: اضغط «جهّز اللعبة». تنفتح صفحة مود Archipelago في الورشة، اضغط Subscribe واستنى ستيم ينزله.",
    "حط عنوان الروم واضغط ▶ العب. البرنامج يكتب اسمك والبورت في إعدادات المود ويشغّل tModLoader.",
    "سوّ عالم جديد وادخله، والمود يتصل لحاله.",
    "الـ checks هي الإنجازات وقتل البوسات."
  ],
  "checks_ar": "الإنجازات وقتل البوسات. ينرسل لحاله أول ما تسويه، وتطلع لك رسالة.",
  "avoid_ar": [
    "استخدم عالم جديد لكل multiworld.",
    "لا تشغّل مودات تغيّر التقدم مع مود Archipelago.",
    "الأغراض اللي توصلك تنعطى لكل اللاعبين في نفس عالم Terraria."
  ],
  "checks_count_ar": "العدد بالضبط يعتمد على خياراتك، ويطلع لكل لاعب في تبويب 📡 الروم بعد التوليد."
}

{
  "id": "sekiro",
  "name": "Sekiro",
  "name_ar": "سيكيرو",
  "game": "Sekiro: Shadows Die Twice",
  "steam_appid": 814380,
  "verified": false,
  "notes_ar": "يحتاج إصدار اللعبة 1.06 (آخر إصدار في ستيم) وتلعب أوفلاين. الكلاينت يولّد ملفات الراندومايزر لحاله بعد ما يتصل.",
  "sources": [
    "https://github.com/yenix4/ArchipelagoSekiro/blob/main/worlds/sekiro/docs/setup_en.md",
    "https://github.com/yenix4/ArchipelagoSekiro/releases",
    "https://github.com/antonovanton000/SekiroArchipelagoClient/releases"
  ],
  "apworld": [
    {
      "type": "github_release",
      "repo": "yenix4/ArchipelagoSekiro",
      "asset": "sekiro.apworld",
      "to": "{custom_worlds}",
      "label": "Sekiro apworld"
    }
  ],
  "install": [
    {
      "type": "github_release",
      "repo": "antonovanton000/SekiroArchipelagoClient",
      "asset": "randomizerAP_windows_*.zip",
      "extract": true,
      "to": "{game_dir}",
      "check": "{game_dir}/randomizerAP/SekiroAPClient.exe",
      "label": "Sekiro Archipelago Client"
    }
  ],
  "connect": [],
  "launch": [
    {
      "type": "run",
      "exe": "{game_dir}/randomizerAP/SekiroAPClient.exe",
      "label": "Sekiro AP Client"
    },
    {
      "type": "manual",
      "id": "launch_client",
      "every_time": true,
      "text_ar": "انفتح لك الكلاينت: اكتب العنوان {address} والاسم {slot} واضغط Connect (يحفظها للمرات الجاية). استنى لين يطلع الـ tracker، وخل اللعبة أوفلاين من إعداداتها، وبعدها اضغط Launch Game."
    }
  ],
  "options": [
    {
      "key": "goal",
      "label_ar": "الهدف",
      "help_ar": "full_game: النهاية العادية. shura: نهاية شورا (أقصر)",
      "default": "full_game",
      "choices": [
        {
          "value": "full_game",
          "label_ar": "اللعبة كاملة"
        },
        {
          "value": "shura",
          "label_ar": "نهاية Shura (أقصر)"
        }
      ]
    }
  ]
}

{
  "id": "the_witness",
  "name": "The Witness",
  "name_ar": "ذا ويتنس",
  "game": "The Witness",
  "steam_appid": 210970,
  "verified": false,
  "notes_ar": "رسمية في Archipelago. لعبة ألغاز. الراندومايزر برنامج صغير يشتغل جنب اللعبة، والبرنامج يشغّله لحاله أول ما تفتح اللعبة.",
  "sources": [
    "https://archipelago.gg/tutorial/The%20Witness/setup/en",
    "https://github.com/NewSoupVi/The-Witness-Randomizer-for-Archipelago",
    "https://github.com/NewSoupVi/witness_archipelago_tracker"
  ],
  "apworld": [
    {
      "type": "apworld_builtin"
    }
  ],
  "install": [
    {
      "type": "github_release",
      "repo": "NewSoupVi/The-Witness-Randomizer-for-Archipelago",
      "asset": "The.Witness.Randomizer.for.Archipelago.exe",
      "to": "{tools}",
      "check": "{tools}/The.Witness.Randomizer.for.Archipelago.exe",
      "label": "The Witness Randomizer"
    }
  ],
  "connect": [],
  "launch": [
    {
      "type": "steam_launch",
      "appid": 210970
    },
    {
      "type": "run",
      "exe": "{tools}/The.Witness.Randomizer.for.Archipelago.exe",
      "label": "The Witness Randomizer",
      "after_process": "witness64_d3d11.exe"
    },
    {
      "type": "manual",
      "id": "connect_witness",
      "every_time": true,
      "text_ar": "ابدأ سيف جديد في اللعبة. نافذة الراندومايزر تنفتح لحالها: اكتب {address} والاسم {slot} (والباسورد لو فيه) واضغط Connect. لو تكمل لعبة: حمّل نفس السيف واضغط Restore Credentials."
    }
  ],

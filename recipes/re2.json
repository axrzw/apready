{
  "id": "re2",
  "name": "Resident Evil 2 Remake",
  "name_ar": "ريزدنت إيفل 2",
  "game": "Resident Evil 2 Remake",
  "steam_appid": 883710,
  "verified": false,
  "notes_ar": "لازم النسخة اللي بدون RTX (من خصائص اللعبة في ستيم > Betas). البرنامج يكتب العنوان والاسم داخل اللعبة، وانت بس تضغط Connect.",
  "sources": [
    "https://fuzzygameson.github.io/RE2R_AP_SetupGuide",
    "https://github.com/FuzzyGamesOn/RE2R_AP_World/releases",
    "https://github.com/FuzzyGamesOn/RE2R_AP_Client",
    "https://github.com/praydog/REFramework/releases",
    "https://github.com/TheRealSolidusSnake/RE2R-Poptracker-Pack"
  ],
  "apworld": [
    {
      "type": "github_release",
      "repo": "FuzzyGamesOn/RE2R_AP_World",
      "asset": "residentevil2remake.apworld",
      "to": "{custom_worlds}",
      "label": "RE2R apworld"
    }
  ],
  "install": [
    {
      "type": "manual",
      "id": "non_rtx",
      "text_ar": "في ستيم: كلك يمين على اللعبة > Properties > Betas واختر النسخة اللي بدون Ray Tracing (dx11_non-rt) واستنى التحديث يخلص. سويتها؟",
      "done_if_exists": "{game_dir}/reframework/autorun/AP_REF/core.lua"
    },
    {
      "type": "github_release",
      "repo": "praydog/REFramework",
      "asset": "RE2_TDB66.zip",
      "extract": true,
      "to": "{game_dir}",
      "label": "REFramework"
    },
    {
      "type": "github_release",
      "repo": "FuzzyGamesOn/RE2R_AP_Client",
      "asset": "__source__",
      "extract": true,
      "strip_top_folder": true,
      "to": "{game_dir}",
      "label": "RE2R AP client"
    }
  ],
  "connect": [
    {
      "type": "write_file",
      "label": "بيانات الاتصال",
      "path": "{game_dir}/reframework/data/AP_REF.json",
      "merge": true,
      "content": {
        "APHost": "{address}",
        "APSlot": "{slot}",
        "APPassword": "{password}"
      }
    }
  ],
  "launch": [
    {
      "type": "steam_launch",
      "appid": 883710
    },
    {
      "type": "manual",
      "id": "connect_re",
      "every_time": true,
      "text_ar": "داخل اللعبة في نافذة Archipelago Client for REFramework تلقى العنوان والاسم مكتوبة لك، اضغط Connect بس. بعدها ابدأ قيم جديد بنفس الشخصية والصعوبة اللي اخترتها."
    }
  ],
  "options": [
    {
      "key": "character",
      "label_ar": "الشخصية",
      "help_ar": "لازم تبدأ القيم بنفس الشخصية",
      "default": "leon",
      "choices": [
        {
          "value": "leon",
          "label_ar": "ليون"
        },
        {
          "value": "claire",
          "label_ar": "كلير"
        }
      ]
    },
    {
      "key": "scenario",
      "label_ar": "السيناريو",
      "help_ar": "A الأول، B الثاني",
      "default": "a",
      "choices": [
        {
          "value": "a",
          "label_ar": "A"
        },
        {
          "value": "b",
          "label_ar": "B"
        }
      ]
    },
    {
      "key": "difficulty",
      "label_ar": "الصعوبة",
      "help_ar": "لازم تلعب بنفس الصعوبة داخل اللعبة",
      "default": "standard",
      "choices": [
        {
          "value": "assisted",
          "label_ar": "سهلة (Assisted)"
        },
        {
          "value": "standard",
          "label_ar": "عادية (Standard)"
        },
        {
          "value": "hardcore",
          "label_ar": "صعبة (Hardcore)"
        }
      ]
    },
    {
      "key": "bonus_start",
      "label_ar": "بداية مع مساعدة",
      "help_ar": "تبدأ مع علاج وذخيرة زيادة",
      "default": false,
      "advanced": true
    },
    {
      "key": "allow_progression_in_labs",
      "label_ar": "أغراض مهمة في المختبر",
      "help_ar": "لو لا، ما ينحط شي مهم في آخر منطقة (أقل انتظار)",
      "default": false,
      "advanced": true
    },
    {
      "key": "cross_scenario_weapons",
      "label_ar": "خلط الأسلحة",
      "help_ar": "يخلط أسلحة السيناريوهات الأربعة",
      "default": "none",
      "choices": [
        {
          "value": "none",
          "label_ar": "لا"
        },
        {
          "value": "starting",
          "label_ar": "سلاح البداية بس"
        },
        {
          "value": "match",
          "label_ar": "نفس النوع"
        },
        {
          "value": "full",
          "label_ar": "كامل"
        },
        {
          "value": "all",
          "label_ar": "كل الأسلحة"
        }
      ],
      "advanced": true
    }
  ],
  "guide_ar": [
    "أول مرة: في ستيم كلك يمين على اللعبة > Properties > Betas واختر النسخة اللي بدون Ray Tracing (dx11_non-rt).",
    "اضغط «جهّز اللعبة»: يركّب REFramework والكلاينت.",
    "اضغط ▶ العب. تطلع نافذة Archipelago Client for REFramework والعنوان واسمك مكتوبة، اضغط Connect.",
    "ابدأ New Game بنفس الشخصية والسيناريو والصعوبة اللي اخترتها هنا.",
    "لو ما طلعت النافذة اضغط Insert."
  ],
  "checks_ar": "كل غرض تلتقطه من الخريطة (أسلحة، ذخيرة، مفاتيح، علاج، صناديق). ينرسل لحاله أول ما تسويه، وتطلع لك رسالة.",
  "avoid_ar": [
    "لا تبدل بين السيفات وأنت تلعب نفس السيد.",
    "استخدم التنقل بالآلة الكاتبة بس لأماكن وصلتها بنفسك، ولا تستخدمه عشان تطلع من قتال بوس أو تتخطى مشهد (تعلق).",
    "لا تلتقط شي داخل RPD قبل ما تسوي أول سيف هناك.",
    "سيّف كثير، خصوصاً بعد البوسات.",
    "لو رجعت لسيف قديم ونقصت أغراضك: في نافذة Archipelago Game Mod اضغط Receive Items Again."
  ],
  "checks_count_ar": "يختلف حسب الشخصية والسيناريو (A / B)، ويزيد كثير مع Killsanity.",
  "map_tracker": {
    "uid": "resident evil 2 remake_ap",
    "variant": "Map Tracker",
    "download": "https://github.com/TheRealSolidusSnake/RE2R-Poptracker-Pack/archive/refs/tags/0.0.1.zip"
  },
  "length": "medium",
  "genres": [
    "horror",
    "action"
  ],
  "beginner": true,
  "tips_ar": [
    "خلّ الصعوبة عادية أول مرة.",
    "الخريطة تبيّن وين الأغراض."
  ],
  "dl_fit": 2,
  "dl_fit_ar": "الموت متوقع بس مو كثير: Death Link يزيد الرعب."
}

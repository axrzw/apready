  ],
  "guide_ar": [
    "أول مرة: اضغط «جهّز اللعبة». البرنامج ينزّل المود ومتطلباته من Thunderstore.",
    "اضغط ▶ العب. البرنامج يكتب بياناتك في إعدادات المود ويشغّل اللعبة.",
    "في اللوبي: خانات Archipelago معبّاة، اضغط Connect to AP، وابدأ الجولة.",
    "لو تلعبون كذا واحد في نفس اللوبي، كل واحد يتصل باسمه."
  ],
  "checks_ar": "حسب طريقة اللعب: في الاستكشاف، الصناديق والمعابد في كل ماب. في الكلاسيك، كل كم غرض تلقطه. ينرسل لحاله.",
  "checks_count_ar": "في الكلاسيك 40 بشكل افتراضي (تقدر لين 250). في الاستكشاف يعتمد على المابات، ويطلع في صفحة الروم بعد التوليد.",
  "avoid_ar": [
    "شغّل اللعبة من البرنامج: ستيم بروحه ممكن يشغّلها بدون المود لو انحذف.",
    "لا تشغّل زر إضافة وأنت ما عندك: أغراضها ومابها ما تطلع لك."
  ],
  "length": "medium",
  "genres": [
    "action",
    "coop"
  ],
  "beginner": true,
  "tips_ar": [
    "كذا واحد يقدر يلعب نفس اللوبي، كل واحد باسمه.",
    "الكلاسيك أسهل أول مرة."
  ],
  "dl_fit": 2,
  "dl_fit_ar": "الموت ينهي الجولة: مع الشباب في نفس اللوبي أحلى."

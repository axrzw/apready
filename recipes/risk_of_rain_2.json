{
  "id": "risk_of_rain_2",
  "name": "Risk of Rain 2",
  "name_ar": "ريسك أوف رين 2",
  "game": "Risk of Rain 2",
  "steam_appid": 632360,
  "verified": false,
  "notes_ar": "كل جولة تقريباً ساعة، وحلوة مع الشباب ومع Death Link. مدعومة رسمياً في Archipelago. البرنامج يركّب المود من Thunderstore ويعبّي بيانات الاتصال في اللعبة.",
  "sources": [
    "https://archipelago.gg/tutorial/Risk%20of%20Rain%202/setup/en",
    "https://thunderstore.io/package/Sneaki/Archipelago/",
    "https://github.com/kindasneaki/Archipelago.RiskOfRain2"
  ],
  "apworld": [
    {
      "type": "apworld_builtin"
    }
  ],
  "install": [
    {
      "type": "thunderstore",
      "packages": [
        "Sneaki-Archipelago"
      ],
      "label": "مود Archipelago (Thunderstore)"
    }
  ],
  "connect": [
    {
      "type": "ini_set",
      "path": "{game_dir}/BepInEx/config/com.Ijwu.Archipelago.cfg",
      "section": "SlotName",
      "values": {
        "slotName": "{slot}"
      },
      "label": "اسمك"
    },
    {
      "type": "ini_set",
      "path": "{game_dir}/BepInEx/config/com.Ijwu.Archipelago.cfg",
      "section": "ServerName",
      "values": {
        "serverName": "{host}"
      },
      "label": "السيرفر"
    },
    {
      "type": "ini_set",
      "path": "{game_dir}/BepInEx/config/com.Ijwu.Archipelago.cfg",
      "section": "Port",
      "values": {
        "port": "{port}"
      },
      "ints": [
        "port"
      ],
      "label": "البورت"
    },
    {
      "type": "ini_set",
      "path": "{game_dir}/BepInEx/config/com.Ijwu.Archipelago.cfg",
      "section": "Password",
      "values": {
        "password": "{password}"
      },
      "label": "الباسورد"
    }
  ],
  "launch": [
    {
      "type": "steam_launch",
      "appid": 632360
    },
    {
      "type": "manual",
      "id": "connect_ror2",
      "every_time": true,
      "text_ar": "ادخل Singleplayer أو Multiplayer: خانات Archipelago معبّاة لك ({address} و {slot})، اضغط Connect to AP، وبعدها ابدأ الجولة."
    }
  ],
  "options": [
    {
      "key": "goal",
      "label_ar": "طريقة اللعب",
      "help_ar": "",
      "default": "explore",
      "choices": [
        {
          "value": "explore",
          "label_ar": "استكشاف: كل ماب فيه تشيكات، والمابات تنفتح بأغراض"
        },
        {
          "value": "classic",
          "label_ar": "كلاسيك: كل كم غرض تلقطه تشيك"
        }
      ]
    },
    {
      "key": "victory",
      "label_ar": "متى تخلص",
      "help_ar": "نهايات الإضافات تشغّل زر الإضافة لحالها",
      "default": "any",
      "choices": [
        {
          "value": "any",
          "label_ar": "أي نهاية"
        },
        {
          "value": "mithrix",
          "label_ar": "تذبح Mithrix"
        },
        {
          "value": "limbo",
          "label_ar": "تذبح Scavenger في Limbo"
        },
        {
          "value": "voidling",
          "label_ar": "تذبح Voidling (Survivors of the Void)",
          "sets": {
            "dlc_sotv": true
          }
        },
        {
          "value": "falseson",
          "label_ar": "تذبح False Son (Seekers of the Storm)",
          "sets": {
            "dlc_sots": true
          }
        }
      ]
    },
    {
      "key": "dlc_sotv",
      "label_ar": "عندي إضافة Survivors of the Void",
      "help_ar": "شغّله بس لو عندك الإضافة",

{
  "id": "re7",
  "name": "Resident Evil 7",
  "name_ar": "ريزدنت إيفل 7",
  "game": "Resident Evil 7",
  "steam_appid": 418370,
  "verified": false,
  "notes_ar": "⚠ المطوّر وقف تطويرها، وفي آخر إصدار رجّع المفاتيح لأماكنها الأصلية عشان ما تعلق. تنلعب بس العشوائية أقل.",
  "sources": [
    "https://github.com/ElGrenier/RE7_AP_World/releases",
    "https://github.com/ElGrenier/RE7_AP_Client"
  ],
  "apworld": [
    {
      "type": "github_release",
      "repo": "ElGrenier/RE7_AP_World",
      "asset": "*.apworld",
      "to": "{custom_worlds}",
      "label": "RE7 apworld"
    }
  ],
  "install": [
    {
      "type": "github_release",
      "repo": "praydog/REFramework",
      "asset": "RE7*.zip",
      "extract": true,
      "to": "{game_dir}",
      "label": "REFramework"
    },
    {
      "type": "github_release",
      "repo": "ElGrenier/RE7_AP_Client",
      "asset": "__source__",
      "extract": true,
      "strip_top_folder": true,
      "to": "{game_dir}",
      "label": "RE7 AP client"
    }
  ],
  "connect": [],
  "launch": [
    {
      "type": "steam_launch",
      "appid": 418370
    },
    {
      "type": "manual",
      "id": "connect_re7",
      "every_time": true,
      "text_ar": "داخل اللعبة اضغط Insert، وفي نافذة Archipelago اكتب {address} والاسم {slot}."
    }
  ],
  "options": []
}
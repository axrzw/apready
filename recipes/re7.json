{
  "id": "re7",
  "name": "Resident Evil 7 Biohazard",
  "name_ar": "ريزدنت إيفل 7",
  "game": "Resident Evil 7",
  "steam_appid": 418370,
  "verified": false,
  "notes_ar": "⚠ المطوّر وقف تطويرها، وفي آخر إصدار رجّع المفاتيح لأماكنها الأصلية عشان ما تعلق. لازم النسخة اللي بدون RTX. البرنامج يكتب العنوان والاسم داخل اللعبة.",
  "sources": [
    "https://github.com/ElGrenier/RE7_AP_World/releases",
    "https://github.com/ElGrenier/RE7_AP_Client",
    "https://github.com/praydog/REFramework/releases"
  ],
  "apworld": [
    {
      "type": "github_release",
      "repo": "ElGrenier/RE7_AP_World",
      "asset": "residentevil7biohazard.apworld",
      "to": "{custom_worlds}",
      "label": "RE7 apworld"
    }
  ],
  "install": [
    {
      "type": "manual",
      "id": "non_rtx",
      "done_if_exists": "{game_dir}/reframework/autorun/AP_REF/core.lua",
      "text_ar": "في ستيم: كلك يمين على اللعبة > Properties > Betas واختر النسخة اللي بدون Ray Tracing (dx11_non-rt) واستنى التحديث يخلص. سويتها؟"
    },
    {
      "type": "github_release",
      "repo": "praydog/REFramework",
      "asset": "RE7_TDB49.zip",
      "extract": true,
      "to": "{game_dir}",
      "label": "REFramework"
    },
    {
      "type": "github_release",
      "repo": "ElGrenier/RE7_AP_Client",
      "asset": "__source__",
      "extract": true,
      "strip_top_folder": true,
      "to": "{game_dir}",
      "label": "RE7 AP client"
    }
  ],
  "connect": [
    {
      "type": "write_file",
      "label": "بيانات الاتصال",
      "path": "{game_dir}/reframework/data/AP_REF.json",
      "merge": true,
      "content": {
        "APHost": "{address}",
        "APSlot": "{slot}",
        "APPassword": "{password}"
      }
    }
  ],
  "launch": [
    {
      "type": "steam_launch",
      "appid": 418370
    },
    {
      "type": "manual",
      "id": "connect_re7",
      "every_time": true,
      "text_ar": "داخل اللعبة اضغط Insert لو ما طلعت نافذة Archipelago. العنوان والاسم مكتوبة لك، اضغط Connect بس."
    }
  ],
  "options": [
    {
      "key": "difficulty",
      "label_ar": "الصعوبة",
      "help_ar": "لازم تلعب بنفس الصعوبة داخل اللعبة",
      "default": "standard",
      "choices": [
        {
          "value": "assisted",
          "label_ar": "سهلة (Casual)"
        },
        {
          "value": "standard",
          "label_ar": "عادية (Normal)"
        },
        {
          "value": "hardcore",
          "label_ar": "صعبة (Madhouse)"
        }
      ]
    },
    {
      "key": "start_at_chapter_2",
      "label_ar": "ابدأ من الفصل 2",
      "help_ar": "الفصل الأول ما يتعشوى (اضغط جرس الباب في البداية)",
      "default": false,
      "advanced": true
    },
    {
      "key": "bonus_start",
      "label_ar": "بداية مع مساعدة",
      "help_ar": "تبدأ مع علاج وذخيرة زيادة",
      "default": false,
      "advanced": true
    }
  ],
  "guide_ar": [
    "أول مرة: في ستيم كلك يمين على اللعبة > Properties > Betas واختر النسخة اللي بدون Ray Tracing (dx11_non-rt).",
    "اضغط «جهّز اللعبة»: يركّب REFramework والكلاينت.",
    "اضغط ▶ العب، وداخل اللعبة اضغط Insert لو ما طلعت نافذة Archipelago. العنوان واسمك مكتوبة، اضغط Connect.",
    "ابدأ New Game بنفس الصعوبة اللي اخترتها هنا."
  ],
  "checks_ar": "كل غرض تلتقطه من الخريطة، والعملات لو فعّلتها. ينرسل لحاله أول ما تسويه، وتطلع لك رسالة.",
  "avoid_ar": [
    "امش على ترتيب القصة: إذا تفاعلت مع شي خارج ترتيبه ممكن تعلق (softlock).",
    "جرس الباب في الفصل الأول ينقلك للفصل الثاني.",
    "المطوّر وقف تطويرها، فتوقع مشاكل."
  ]
}

  "death_link_key": null,
  "guide_ar": [
    "اضغط ▶ العب: البرنامج يشغّل Peacock و PeacockPatcher وكلاينت HITMAN متصل بالروم، ويشغّل اللعبة.",
    "تأكد إن القائمة الرئيسية فيها «Powered by The Peacock Project».",
    "المراحل اللي فتحتها تطلع في Campaigns > Archipelago.",
    "لو وصلتك مرحلة وانت في القائمة، ادخل مرحلة واطلع، أو Go Offline ثم Go Online."
  ],
  "checks_ar": "إكمال كل مرحلة، وتقييمات Silent Assassin / Suit Only، وقتل الأهداف. واختيارياً التقاط الأغراض واللبسات. ينرسل لحاله أول ما تسويه، وتطلع لك رسالة.",
  "avoid_ar": [
    "شغّلها دايم من زر العب (مع Peacock). بدونه تتصل بسيرفرات IOI الرسمية.",
    "لا تستخدم Peacock اللي تلعب فيه عادي، البرنامج يستخدم نسخة خاصة.",
    "هذي اللعبة ما فيها Death Link."
  ],
  "checks_count_ar": "العدد بالضبط يعتمد على خياراتك، ويطلع لكل لاعب في صفحة الروم بعد التوليد.",

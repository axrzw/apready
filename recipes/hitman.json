{
  "id": "hitman",
  "name": "HITMAN World of Assassination",
  "name_ar": "هيتمان",
  "game": "HITMAN World of Assassination",
  "steam_appid": 1659040,
  "verified": false,
  "notes_ar": "يشتغل عن طريق Peacock (سيرفر محلي بدل سيرفرات IOI). البرنامج يشغّل Peacock والكلاينت متصل لحاله. المراحل تطلع في Campaigns > Archipelago.",
  "sources": [
    "https://github.com/BenDipp/Archipelago/releases",
    "https://thepeacockproject.org/wiki/intel/installation/",
    "https://github.com/thepeacockproject/Peacock/releases"
  ],
  "apworld": [
    {
      "type": "github_release",
      "repo": "BenDipp/Archipelago",
      "asset": "hitman_woa.apworld",
      "to": "{custom_worlds}",
      "label": "Hitman apworld"
    }
  ],
  "install": [
    {
      "type": "github_release",
      "repo": "thepeacockproject/Peacock",
      "asset": "Peacock-v*[0-9].zip",
      "extract": true,
      "strip_top_folder": true,
      "to": "{tools}/Peacock",
      "label": "Peacock"
    },
    {
      "type": "github_release",
      "repo": "BenDipp/Archipelago",
      "asset": "archipelago.plugin.js",
      "to": "{tools}/Peacock/plugins",
      "label": "Archipelago plugin for Peacock"
    }
  ],
  "connect": [],
  "launch": [
    {
      "type": "run",
      "exe": "{tools}/Peacock/Start Server.cmd",
      "label": "Peacock server"
    },
    {
      "type": "run",
      "exe": "{tools}/Peacock/PeacockPatcher.exe",
      "label": "PeacockPatcher"
    },
    {
      "type": "run",
      "exe": "{ap_dir}/ArchipelagoLauncher.exe",
      "label": "HITMAN World of Assassination Client",
      "args": [
        "HITMAN World of Assassination Client",
        "--",
        "--connect",
        "{address}",
        "--name",
        "{slot}"
      ],
      "optional_args": {
        "--password": "{password}"
      }
    },
    {
      "type": "steam_launch",
      "appid": 1659040
    }
  ],
  "options": [],
  "death_link_key": null
}

{
  "id": "cuphead",
  "name": "Cuphead",
  "name_ar": "كب هيد",
  "game": "Cuphead",
  "steam_appid": 268910,
  "verified": false,
  "notes_ar": "المود لسا ألفا، توقعوا مشاكل. يحتاج BepInEx 5. البرنامج يفعّل Archipelago على سيف فاضي خاص بالمود (سيفاتك العادية ما تنلمس). Death Link يشتغل داخل المراحل بس، مو على الخريطة.",
  "sources": [
    "https://github.com/JKLeckr/CupheadArchipelagoMod",
    "https://github.com/JKLeckr/CupheadArchipelagoMod/blob/main/INSTALLING.md",
    "https://github.com/JKLeckr/Archipelago-cuphead/releases"
  ],
  "apworld": [
    {
      "type": "github_release",
      "repo": "JKLeckr/Archipelago-cuphead",
      "asset": "cuphead.apworld",
      "to": "{custom_worlds}",
      "label": "Cuphead apworld"
    }
  ],
  "install": [
    {
      "type": "github_release",
      "repo": "BepInEx/BepInEx",
      "tag": "v5.4.23.2",
      "asset": "BepInEx_win_x64_5.4.23.2.zip",
      "extract": true,
      "to": "{game_dir}",
      "label": "BepInEx 5"
    },
    {
      "type": "github_release",
      "repo": "JKLeckr/CupheadArchipelagoMod",
      "asset": "CupheadArchipelago-*_win64.zip",
      "extract": true,
      "to": "{game_dir}/BepInEx/plugins",
      "check": "{game_dir}/BepInEx/plugins/CupheadArchipelago",
      "label": "Cuphead Archipelago mod"
    }
  ],
  "connect": [
    {
      "type": "save_slot_json",
      "label": "تجهيز السيف",
      "dir": "{appdata}/Cuphead",
      "slots": 3,
      "file": "cuphead_player_data_v1_ap_slot_{n}_apdata.sav",
      "game_file": "cuphead_player_data_v1_ap_slot_{n}.sav",
      "values": {
        "address": "{host}",
        "port": "{port}",
        "player": "{slot}",
        "password": "{password}"
      },
      "ints": [
        "port"
      ]
    }
  ],
  "launch": [
    {
      "type": "steam_launch",
      "appid": 268910
    },
    {
      "type": "manual",
      "id": "connect_cuphead",
      "every_time": true,
      "text_ar": "اختر السيف رقم {save_slot} (عليه AP، وكل شي مكتوب فيه)، وابدأ اللعب. لو طلع لك Seed mismatch يعني لعبة جديدة: اضغط طلّع ملفي مرة ثانية وبعدها العب."
    }
  ],
  "options": [],
  "death_link_key": "deathlink",
  "guide_ar": [
    "أول مرة: اضغط «جهّز اللعبة» (يركّب BepInEx والمود).",
    "بعد ما تطلّع ملفك والمستضيف يولّد، اضغط ▶ العب: البرنامج يفعّل Archipelago على سيف فاضي خاص بالمود، ويقولك رقمه.",
    "في شاشة السيفات اختر هذا السيف (عليه AP) وابدأ.",
    "Death Link يشتغل داخل المراحل بس، مو على الخريطة.",
    "لو طلع لك Seed mismatch يعني لعبة جديدة: اضغط «طلّع ملفي» مرة ثانية وبعدها العب."
  ]
}

          "label_ar": "عشوائية متوازنة"
        },
        {
          "value": "random_chaotic",
          "label_ar": "عشوائية فوضى"
        }
      ]
    },
    {
      "key": "flip_levels",
      "label_ar": "قلب المراحل",
      "help_ar": "",
      "default": "vanilla",
      "advanced": true,
      "choices": [
        {
          "value": "vanilla",
          "label_ar": "عادي"
        },
        {
          "value": "flipped",
          "label_ar": "كلها مقلوبة"
        },
        {
          "value": "randomly_flipped",
          "label_ar": "بعضها مقلوب"
        }
      ]
    }
  ],
  "guide_ar": [
    "اللعبة لازم تكون مثبتة من ستيم (ملف DOOM.WAD يجي معها).",
    "اضغط «جهّز اللعبة»: ينزّل APDOOM وينسخ DOOM.WAD لها.",
    "اضغط ▶ العب: تنفتح اللعبة ومتصلة بالروم. ما تكتب شي.",
    "من شاشة المراحل اختر أي مرحلة مفتوحة. المراحل تنفتح بأغراض تجيك من الشباب.",
    "للهنت داخل اللعبة: T وبعدها مثلاً !hint e1m3 map"
  ],
  "checks_ar": "كل غرض في المراحل (أسلحة، مفاتيح، دروع، خرائط...) تشيك، وتخليص المرحلة تشيك. ينرسل لحاله.",
  "checks_count_ar": "العدد يعتمد على الحلقات اللي تختارها، ويطلع لكل لاعب في تبويب 📡 الروم بعد التوليد.",
  "avoid_ar": [
    "لا تشغّلها من ستيم: نسخة ستيم ما فيها Archipelago. شغّلها من زر ▶ العب.",
    "الموت يرجّع المرحلة من أولها (لو خيار «ترجع المرحلة لما تموت» شغّال)، بس أغراضك وتشيكاتك تبقى."
  ],
  "map_tracker": {
    "uid": "ap_doom",
    "variant": "standard",
    "download": "https://github.com/Ozone31/doom-ap-tracker/archive/refs/tags/v1.2.3.zip"
  },
  "death_link_key": "death_link"
}

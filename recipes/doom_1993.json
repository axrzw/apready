{
  "id": "doom_1993",
  "name": "DOOM (1993)",
  "name_ar": "DOOM (1993)",
  "game": "DOOM 1993",
  "steam_appid": 2280,
  "verified": false,
  "notes_ar": "رسمية في Archipelago. تنلعب بنسخة APDOOM (Crispy Doom معدّلة) وملف اللعبة الأصلي DOOM.WAD من ستيم. البرنامج ينزّلها وينسخ الملف ويشغّلها متصلة بالروم لحالها.",
  "sources": [
    "https://archipelago.gg/tutorial/DOOM%201993/setup/en",
    "https://github.com/Daivuk/apdoom",
    "https://github.com/Ozone31/doom-ap-tracker"
  ],
  "apworld": [
    {
      "type": "apworld_builtin"
    }
  ],
  "install": [
    {
      "type": "github_release",
      "repo": "Daivuk/apdoom",
      "asset": "*APDOOM*Win32.zip",
      "extract": true,
      "to": "{tools}",
      "check": "{tools}/crispy-apdoom.exe",
      "label": "APDOOM"
    },
    {
      "type": "copy",
      "from": "{game_dir}/base/DOOM.WAD",
      "to": "{tools}/DOOM.WAD",
      "label": "DOOM.WAD",
      "missing_ar": "ما لقيت DOOM.WAD في مجلد اللعبة (base). تأكد إن اللعبة مثبتة كاملة من ستيم."
    }
  ],
  "connect": [],
  "launch": [
    {
      "type": "run",
      "exe": "{tools}/crispy-apdoom.exe",
      "label": "APDOOM",
      "args": [
        "-game",
        "doom",
        "-apserver",
        "{address}",
        "-applayerhex",
        "{slot_hex}"
      ],
      "optional_args": {
        "-password": "{password}"
      }
    },
    {
      "type": "manual",
      "id": "connect_doom_1993",
      "every_time": true,
      "text_ar": "اللعبة تتصل بالروم لحالها. تختار المرحلة من الشاشة اللي تطلع (فيها المفاتيح والتشيكات لكل مرحلة)."
    }
  ],
  "options": [
    {
      "key": "goal",
      "label_ar": "متى تخلص",
      "help_ar": "",
      "default": "complete_all_levels",
      "choices": [
        {
          "value": "complete_all_levels",
          "label_ar": "تخلص كل مراحل الحلقات المختارة"
        },
        {
          "value": "complete_boss_levels",
          "label_ar": "تخلص مراحل الزعماء بس"
        }
      ]
    },
    {
      "key": "difficulty",
      "label_ar": "الصعوبة",
      "help_ar": "",
      "default": "medium",
      "choices": [
        {
          "value": "baby",
          "label_ar": "I'm too young to die (أسهل)"
        },
        {
          "value": "easy",
          "label_ar": "Hey, not too rough"
        },
        {
          "value": "medium",
          "label_ar": "Hurt me plenty (عادي)"
        },
        {
          "value": "hard",
          "label_ar": "Ultra-Violence"
        },
        {
          "value": "nightmare",
          "label_ar": "Nightmare!"
        }
      ]
    },
    {
      "key": "episode1",
      "label_ar": "الحلقة 1: Knee-Deep in the Dead",
      "help_ar": "",
      "default": true
    },
    {
      "key": "episode2",
      "label_ar": "الحلقة 2: The Shores of Hell",
      "help_ar": "",
      "default": true
    },
    {
      "key": "episode3",
      "label_ar": "الحلقة 3: Inferno",
      "help_ar": "",
      "default": true
    },
    {
      "key": "episode4",
      "label_ar": "الحلقة 4: Thy Flesh Consumed",
      "help_ar": "",
      "default": false
    },
    {
      "key": "reset_level_on_death",
      "label_ar": "ترجع المرحلة لما تموت",
      "help_ar": "الوحوش ترجع، بس أغراضك وتشيكاتك تبقى",
      "default": true,
      "advanced": true
    },
    {
      "key": "random_monsters",
      "label_ar": "الوحوش",
      "help_ar": "",
      "default": "shuffle",
      "advanced": true,
      "choices": [
        {
          "value": "vanilla",
          "label_ar": "زي اللعبة"

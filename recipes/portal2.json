{
  "id": "portal2",
  "name": "Portal 2",
  "name_ar": "بورتال 2",
  "game": "Portal 2",
  "steam_appid": 620,
  "verified": false,
  "notes_ar": "المود يطلع في مكتبة ستيم كلعبة اسمها Portal 2 Archipelago Mod. لازم نسخة المود والـ apworld من نفس الإصدار.",
  "sources": [
    "https://github.com/GlassToadstool/Portal2ArchipelagoMod",
    "https://github.com/GlassToadstool/Portal2ArchipelagoMod/releases"
  ],
  "apworld": [
    {
      "type": "github_release",
      "repo": "GlassToadstool/Portal2ArchipelagoMod",
      "asset": "*.apworld",
      "to": "{custom_worlds}",
      "label": "Portal 2 apworld + client"
    }
  ],
  "install": [
    {
      "type": "github_release",
      "repo": "GlassToadstool/Portal2ArchipelagoMod",
      "asset": "*.zip",
      "extract": true,
      "to": "{sourcemods}",
      "label": "Portal 2 Archipelago Mod"
    },
    {
      "type": "manual",
      "id": "restart_steam",
      "text_ar": "سكّر ستيم وافتحه من جديد. بعدها بتلقى Portal 2 Archipelago Mod في مكتبتك. كلك يمين عليه > Properties، وحط خيارات التشغيل اللي في صفحة المود. سويتها؟",
      "url": "https://github.com/GlassToadstool/Portal2ArchipelagoMod#installation"
    }
  ],
  "connect": [],
  "launch": [
    {
      "type": "run",
      "exe": "{ap_dir}/ArchipelagoLauncher.exe",
      "args": [
        "Portal 2 Client"
      ]
    },
    {
      "type": "manual",
      "id": "connect_portal2",
      "every_time": true,
      "text_ar": "في نافذة Portal 2 Client اكتب {address} واضغط Connect، والاسم {slot}. بعدها شغّل Portal 2 Archipelago Mod من ستيم."
    }
  ],
  "options": []
}
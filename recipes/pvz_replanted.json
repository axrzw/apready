{
  "id": "pvz_replanted",
  "name": "Plants vs. Zombies: Replanted",
  "name_ar": "النباتات ضد الزومبي (Replanted)",
  "game": "Plants vs. Zombies",
  "steam_appid": 3654560,
  "verified": false,
  "notes_ar": "النسخة الجديدة Replanted على ستيم. البرنامج يركّب MelonLoader والمود ويكتب الاتصال لك.",
  "sources": [
    "https://github.com/dannybonz/replanted_archipelago/blob/main/apworld/docs/setup.md",
    "https://github.com/dannybonz/replanted_archipelago/releases",
    "https://github.com/LavaGang/MelonLoader/releases"
  ],
  "apworld": [
    {
      "type": "github_release",
      "repo": "dannybonz/replanted_archipelago",
      "asset": "pvzr.apworld",
      "to": "{custom_worlds}",
      "label": "PvZ apworld"
    }
  ],
  "install": [
    {
      "type": "github_release",
      "repo": "LavaGang/MelonLoader",
      "asset": "MelonLoader.x64.zip",
      "extract": true,
      "to": "{game_dir}",
      "check": "{game_dir}/version.dll",
      "label": "MelonLoader"
    },
    {
      "type": "github_release",
      "repo": "dannybonz/replanted_archipelago",
      "asset": "replanted_archipelago_*.zip",
      "extract": true,
      "to": "{game_dir}",
      "check": "{game_dir}/Mods/ReplantedArchipelago.dll",
      "label": "Replanted Archipelago mod"
    }
  ],
  "connect": [
    {
      "type": "ini_set",
      "label": "بيانات الاتصال",
      "path": "{game_dir}/UserData/MelonPreferences.cfg",
      "section": "Archipelago Connection",
      "quote": true,
      "values": {
        "Host": "{address}",
        "SlotName": "{slot}",
        "Password": "{password}"
      }
    }
  ],
  "launch": [
    {
      "type": "steam_launch",
      "appid": 3654560
    },
    {
      "type": "manual",
      "id": "connect_pvz",
      "every_time": true,
      "text_ar": "أول ما تفتح اللعبة تطلع لك بيانات الاتصال مكتوبة، اضغط اتصال بس. أول تشغيل بعد MelonLoader ياخذ وقت أطول."
    }
  ],
  "options": [
    {
      "key": "adventure_levels_goal",
      "label_ar": "متى تخلص: كم مرحلة Adventure",
      "help_ar": "",
      "default": 49,
      "min": 0,
      "max": 49
    },
    {
      "key": "fast_goal",
      "label_ar": "هدف سريع",
      "help_ar": "",
      "default": false
    },
    {
      "key": "minigame_levels",
      "label_ar": "Mini-games",
      "help_ar": "",
      "default": "randomised_order",
      "advanced": true,
      "choices": [
        {
          "value": "off",
          "label_ar": "لا"
        },
        {
          "value": "vanilla",
          "label_ar": "الأصلي"
        },
        {
          "value": "randomised_order",
          "label_ar": "ترتيب عشوائي"
        },
        {
          "value": "open",
          "label_ar": "مفتوحة"
        },
        {
          "value": "level_items",
          "label_ar": "تفتحها أغراض"
        }
      ]
    },
    {
      "key": "puzzle_levels",
      "label_ar": "Puzzle",
      "help_ar": "",
      "default": "randomised_order",
      "advanced": true,
      "choices": [
        {

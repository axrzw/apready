  ],
  "guide_ar": [
    "اضغط «جهّز اللعبة» (يركّب MelonLoader والمود).",
    "اضغط ▶ العب. أول تشغيل بعد MelonLoader ياخذ وقت أطول.",
    "تطلع لك نافذة الاتصال وفيها العنوان واسمك، اضغط اتصال."
  ],
  "checks_ar": "إكمال المراحل (Adventure، Mini-games، Puzzle، Survival، I Zombie) والأوضاع الإضافية. ينرسل لحاله أول ما تسويه، وتطلع لك رسالة.",
  "avoid_ar": [
    "أول تشغيل بعد MelonLoader ياخذ وقت، لا تسكّره."
  ],
  "checks_count_ar": "العدد بالضبط يعتمد على خياراتك، ويطلع لكل لاعب في تبويب 📡 الروم بعد التوليد."
}

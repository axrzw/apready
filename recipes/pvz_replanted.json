        },
        {
          "value": "level_items",
          "label_ar": "تفتحها أغراض"
        }
      ]
    },
    {
      "key": "survival_levels",
      "label_ar": "Survival",
      "help_ar": "",
      "default": "randomised_order",
      "advanced": true,
      "choices": [
        {
          "value": "off",
          "label_ar": "لا"
        },
        {
          "value": "vanilla",
          "label_ar": "الأصلي"
        },
        {
          "value": "randomised_order",
          "label_ar": "ترتيب عشوائي"
        },
        {
